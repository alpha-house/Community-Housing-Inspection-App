{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "ahb_sharedcommondataserviceforapps_c4d89"
        },
        "runtimeSource": "embedded"
      },
      "shared_approvals": {
        "api": {
          "name": "shared_approvals"
        },
        "connection": {
          "connectionReferenceLogicalName": "cp_sharedapprovals_32ba0"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "ahb_sharedoffice365_75361"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "CSR Environment Url and App ID (cp_CSREnvironmentUrlandAppID)": {
          "defaultValue": "https://ahc-sandbox.crm3.dynamics.com/main.aspx?appid=8787c2ca-1182-f111-8076-7c1e5253346f&pagetype=entityrecord&etn=cp_communityservicerequest&id=",
          "type": "String",
          "metadata": {
            "schemaName": "cp_CSREnvironmentUrlandAppID",
            "description": "Environment url and app id for the Community Housing Inspection app. Used by the cp Service Request Approval flow to link to the record."
          }
        }
      },
      "triggers": {
        "When_CSR_is_added_or_modified": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "cp_communityservicerequest",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "cp_requestapproval"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "connectionName": "shared_commondataserviceforapps"
            }
          }
        }
      },
      "actions": {
        "Get_CSR_by_ID": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "cp_communityservicerequests",
              "recordId": "@triggerOutputs()?['body/cp_communityservicerequestid']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "GetItem",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "runAfter": {}
        },
        "Initialize_Approver_Emails": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "ApproverEmails",
                "type": "array"
              }
            ]
          },
          "runAfter": {
            "Get_CSR_by_ID": [
              "Succeeded"
            ]
          }
        },
        "Condition_new_record_or_old-record-and-requestapproval-is-true": {
          "type": "If",
          "expression": {
            "or": [
              {
                "equals": [
                  "@triggerOutputs()?['body/createdon']",
                  "@triggerOutputs()?['body/modifiedon']"
                ]
              },
              {
                "equals": [
                  "@outputs('Get_CSR_by_ID')?['body/cp_requestapproval']",
                  true
                ]
              }
            ]
          },
          "actions": {
            "Get_owner_by_ID": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "systemusers",
                  "recordId": "@outputs('Get_CSR_by_ID')?['body/_modifiedby_value']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "List_approvers": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cp_servicerequestapprovers",
                  "$select": "_cp_approver_value"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "Get_owner_by_ID": [
                  "Succeeded"
                ]
              }
            },
            "For_each_3": {
              "type": "Foreach",
              "foreach": "@outputs('List_approvers')?['body/value']",
              "actions": {
                "Get_staff_by_ID": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "cp_staffs",
                      "recordId": "@items('For_each_3')?['_cp_approver_value']"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "GetItem",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  }
                },
                "Append_to_array_variable": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "ApproverEmails",
                    "value": "@outputs('Get_staff_by_ID')?['body/cp_email']"
                  },
                  "runAfter": {
                    "Get_staff_by_ID": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "List_approvers": [
                  "Succeeded"
                ]
              }
            },
            "join_emails_with_semicolon": {
              "type": "Compose",
              "inputs": "@join(variables('ApproverEmails'),';')",
              "runAfter": {
                "For_each_3": [
                  "Succeeded"
                ]
              }
            },
            "Start_and_wait_for_an_approval": {
              "type": "OpenApiConnectionWebhook",
              "inputs": {
                "parameters": {
                  "approvalType": "CustomResponse",
                  "WebhookApprovalCreationInput/responseOptions": [
                    "Needs Review",
                    "Approved",
                    "Rejected"
                  ],
                  "WebhookApprovalCreationInput/title": "@{outputs('Get_CSR_by_ID')?['body/cp_communityservicerequestname']} - Service Request Approval",
                  "WebhookApprovalCreationInput/assignedTo": "@outputs('join_emails_with_semicolon')",
                  "WebhookApprovalCreationInput/details": "Service Request Approval is requested by @{outputs('Get_owner_by_ID')?['body/fullname']}. Please read these comments for more information: @{triggerOutputs()?['body/cp_submitterscomments']}",
                  "WebhookApprovalCreationInput/itemLink": "@{parameters('CSR Environment Url and App ID (cp_CSREnvironmentUrlandAppID)')}@{triggerOutputs()?['body/cp_communityservicerequestid']}",
                  "WebhookApprovalCreationInput/itemLinkDescription": "Please click the link to open the service request for review.",
                  "WebhookApprovalCreationInput/enableNotifications": true,
                  "WebhookApprovalCreationInput/enableReassignment": true
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
                  "operationId": "StartAndWaitForAnApproval",
                  "connectionName": "shared_approvals"
                }
              },
              "runAfter": {
                "join_emails_with_semicolon": [
                  "Succeeded"
                ]
              }
            },
            "Switch": {
              "type": "Switch",
              "expression": "@outputs('Start_and_wait_for_an_approval')?['body/outcome']",
              "default": {
                "actions": {}
              },
              "cases": {
                "Needs_Review": {
                  "actions": {
                    "For_each": {
                      "type": "Foreach",
                      "foreach": "@outputs('Start_and_wait_for_an_approval')?['body/responses']",
                      "actions": {
                        "Update_to_Needs_Review": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "entityName": "cp_communityservicerequests",
                              "recordId": "@triggerOutputs()?['body/cp_communityservicerequestid']",
                              "item/cp_approverscomments": "@items('For_each')?['comments']",
                              "item/cp_requestapproval": false,
                              "item/cp_srapprovalstatus": 121570001
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                              "operationId": "UpdateOnlyRecord",
                              "connectionName": "shared_commondataserviceforapps"
                            }
                          }
                        },
                        "Get_CSR_Creator": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "entityName": "systemusers",
                              "recordId": "@outputs('Update_to_Needs_Review')?['body/_createdby_value']"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                              "operationId": "GetItem",
                              "connectionName": "shared_commondataserviceforapps"
                            }
                          },
                          "runAfter": {
                            "Update_to_Needs_Review": [
                              "Succeeded"
                            ]
                          }
                        },
                        "Send_an_email_(V2)": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "emailMessage/To": "@outputs('Get_CSR_Creator')?['body/domainname']",
                              "emailMessage/Subject": "Review Comments",
                              "emailMessage/Body": "<p class=\"editor-paragraph\">Hello,</p><br><p class=\"editor-paragraph\">Please see comments for the Community Housing Service Repair Request you submitted.</p><br><p class=\"editor-paragraph\">See comments below:</p><p class=\"editor-paragraph\">@{items('For_each')?['comments']}</p><br><p class=\"editor-paragraph\">Please click the link below to modify your request:</p><p class=\"editor-paragraph\">@{parameters('CSR Environment Url and App ID (cp_CSREnvironmentUrlandAppID)')}@{triggerOutputs()?['body/cp_communityservicerequestid']}</p><br><p class=\"editor-paragraph\">Thank you.</p>",
                              "emailMessage/Importance": "Normal"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "operationId": "SendEmailV2",
                              "connectionName": "shared_office365"
                            }
                          },
                          "runAfter": {
                            "Get_CSR_Creator": [
                              "Succeeded"
                            ]
                          }
                        }
                      }
                    }
                  },
                  "case": "Needs Review"
                },
                "Approved": {
                  "actions": {
                    "For_each_1": {
                      "type": "Foreach",
                      "foreach": "@outputs('Start_and_wait_for_an_approval')?['body/responses']",
                      "actions": {
                        "Update_to_Approved": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "entityName": "cp_communityservicerequests",
                              "recordId": "@triggerOutputs()?['body/cp_communityservicerequestid']",
                              "item/cp_approverscomments": "@items('For_each_1')?['comments']",
                              "item/cp_requestapproval": false,
                              "item/cp_srapprovalstatus": 121570002
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                              "operationId": "UpdateOnlyRecord",
                              "connectionName": "shared_commondataserviceforapps"
                            }
                          }
                        }
                      }
                    }
                  },
                  "case": "Approved"
                },
                "Rejected": {
                  "actions": {
                    "For_each_2": {
                      "type": "Foreach",
                      "foreach": "@outputs('Start_and_wait_for_an_approval')?['body/responses']",
                      "actions": {
                        "Update_to_Rejected": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "entityName": "cp_communityservicerequests",
                              "recordId": "@triggerOutputs()?['body/cp_communityservicerequestid']",
                              "item/cp_approverscomments": "@items('For_each_2')?['comments']",
                              "item/cp_requestapproval": false,
                              "item/cp_srapprovalstatus": 121570003
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                              "operationId": "UpdateOnlyRecord",
                              "connectionName": "shared_commondataserviceforapps"
                            }
                          }
                        }
                      }
                    }
                  },
                  "case": "Rejected"
                }
              },
              "runAfter": {
                "Start_and_wait_for_an_approval": [
                  "Succeeded"
                ]
              }
            },
            "Find_responder_staff": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "cp_staffs",
                  "$select": "cp_staffid",
                  "$filter": "cp_email eq '@{replace(first(outputs('Start_and_wait_for_an_approval')?['body/responses'])?['responder']?['email'], '''', '''''')}'",
                  "$top": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "Switch": [
                  "Succeeded"
                ]
              }
            },
            "Condition_responder_is_staff": {
              "type": "If",
              "expression": {
                "greater": [
                  "@length(outputs('Find_responder_staff')?['body/value'])",
                  0
                ]
              },
              "actions": {
                "Update_Approved_By": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "cp_communityservicerequests",
                      "recordId": "@triggerOutputs()?['body/cp_communityservicerequestid']",
                      "item/cp_ApprovedBy@odata.bind": "cp_staffs(@{first(outputs('Find_responder_staff')?['body/value'])?['cp_staffid']})"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Find_responder_staff": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Initialize_Approver_Emails": [
              "Succeeded"
            ]
          }
        }
      },
      "description": "Sends an approval to all cp_servicerequestapprover staff when cp_requestapproval is set on a community service request, then records the outcome."
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}